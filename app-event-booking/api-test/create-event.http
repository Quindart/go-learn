@baseUrl = http://localhost:3001
# Run sign-in.http, then paste the response token here (without "Bearer").
@token = REPLACE_WITH_SIGNIN_TOKEN

### Create an event owned by the signed-in user.
POST {{baseUrl}}/events
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Tét",
    "description": "ABC ABCD",
    "location": "HCM city",
    "date" : "2025-01-01T15:40:00.00Z"
}
